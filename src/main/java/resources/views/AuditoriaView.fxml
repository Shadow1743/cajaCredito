<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="20.0" style="-fx-padding: 30px;" stylesheets="@../styles/application.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cooperativa.controller.AuditoriaController">
    <VBox spacing="16.0" styleClass="card-pane" VBox.vgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT" spacing="15.0">
            <VBox HBox.hgrow="ALWAYS">
                <Label styleClass="module-title" text="Bitácora de Auditoría y Control Interno" />
                <Label styleClass="module-subtitle" text="Supervisión en modo solo lectura de operaciones críticas, cierres y trazabilidad de usuarios" />
            </VBox>
            <Button onAction="#cargarBitacora" styleClass="primary-button" text="Actualizar Bitácora" />
        </HBox>

        <TableView fx:id="tablaBitacora" prefHeight="420.0" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colIdBitacora" prefWidth="70.0" text="ID" />
                <TableColumn fx:id="colFechaHora" prefWidth="160.0" text="Fecha y Hora" />
                <TableColumn fx:id="colUsuario" prefWidth="180.0" text="Usuario Responsable" />
                <TableColumn fx:id="colAccion" prefWidth="170.0" text="Acción Ejecutada" />
                <TableColumn fx:id="colTabla" prefWidth="130.0" text="Tabla Afectada" />
                <TableColumn fx:id="colDescripcion" prefWidth="360.0" text="Descripción del Cambio / Evento" />
            </columns>
        </TableView>
    </VBox>
</VBox>