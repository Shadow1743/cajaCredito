<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="20.0" style="-fx-padding: 30px;" stylesheets="@../styles/application.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cooperativa.controller.CreditoSimuladorController">
    <VBox spacing="20.0" styleClass="card-pane">
        <VBox spacing="4.0">
            <Label styleClass="module-title" text="Gestión de Solicitudes de Crédito" />
            <Label styleClass="module-subtitle" text="Registro de solicitud, evaluación crediticia y cálculo de tabla de amortización" />
        </VBox>

        <GridPane hgap="22.0" vgap="16.0">
            <columnConstraints>
                <ColumnConstraints percentWidth="50.0" />
                <ColumnConstraints percentWidth="50.0" />
            </columnConstraints>

            <VBox spacing="5.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                <Label styleClass="field-label" text="Buscar Socio (DUI o ID):" />
                <HBox spacing="8.0">
                    <TextField fx:id="txtBuscarSocioDui" promptText="Ej. 02458963-1" HBox.hgrow="ALWAYS" />
                    <Button onAction="#validarSocioYEquifax" style="-fx-background-color: #0B3B24; -fx-text-fill: white;" text="Evaluar" />
                </HBox>
            </VBox>

            <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                <Label styleClass="field-label" text="Monto Solicitado ($):" />
                <TextField fx:id="txtMontoSolicitado" promptText="Ej. 2500.00" />
            </VBox>

            <VBox spacing="5.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
                <Label styleClass="field-label" text="Tipo de Crédito / Garantía:" />
                <ComboBox fx:id="cmbTipoGarantia" maxWidth="Infinity" promptText="Seleccione garantía..." />
            </VBox>

            <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                <Label styleClass="field-label" text="Plazo en Meses:" />
                <TextField fx:id="txtPlazoMeses" promptText="Ej. 24" />
            </VBox>

            <VBox spacing="5.0" GridPane.columnIndex="0" GridPane.rowIndex="2">
                <Label styleClass="field-label" text="Tasa de Interés Anual (%):" />
                <TextField fx:id="txtTasaInteres" promptText="Ej. 14.00" />
            </VBox>

            <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
                <Label styleClass="field-label" text="¿Posee créditos activos?:" />
                <ComboBox fx:id="cmbCreditosActivos" maxWidth="Infinity" />
            </VBox>

            <VBox spacing="5.0" GridPane.columnIndex="0" GridPane.rowIndex="3">
                <Label styleClass="field-label" text="Estado en Central de Riesgo / Solvencia (Equifax):" />
                <TextField fx:id="txtEstadoCentralRiesgo" editable="false" promptText="Pendiente de evaluación..." />
            </VBox>

            <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="3">
                <Label styleClass="field-label" text="Destino del Préstamo / Descripción de Garantía:" />
                <TextField fx:id="txtDestinoCredito" promptText="Ej. Capital de trabajo / Compra de equipo" />
            </VBox>
        </GridPane>

        <HBox alignment="CENTER" spacing="15.0">
            <Button onAction="#registrarSolicitud" styleClass="primary-button" text="Registrar Solicitud" />
        </HBox>
    </VBox>
</VBox>