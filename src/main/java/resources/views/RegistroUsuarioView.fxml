<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="20.0" style="-fx-padding: 30px;" stylesheets="@../styles/application.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cooperativa.controller.RegistroUsuarioController">
    <VBox spacing="22.0" styleClass="card-pane">
        <VBox spacing="4.0">
            <Label styleClass="module-title" text="Registro de Usuarios del Sistema" />
            <Label styleClass="module-subtitle" text="Alta de nuevo personal administrativo y asignación de roles" />
        </VBox>

        <GridPane hgap="24.0" vgap="18.0">
            <columnConstraints>
                <ColumnConstraints percentWidth="50.0" />
                <ColumnConstraints percentWidth="50.0" />
            </columnConstraints>

            <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                <Label styleClass="field-label" text="Nombres:" />
                <TextField fx:id="txtNombres" promptText="Ej. Juan Carlos" />
            </VBox>

            <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                <Label styleClass="field-label" text="Apellidos:" />
                <TextField fx:id="txtApellidos" promptText="Ej. Pérez Martínez" />
            </VBox>

            <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
                <Label styleClass="field-label" text="Número de DUI (Usuario de acceso):" />
                <TextField fx:id="txtDuiUsuario" promptText="Ej. 01234567-8" />
            </VBox>

            <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                <Label styleClass="field-label" text="Correo Electrónico Institucional:" />
                <TextField fx:id="txtCorreo" promptText="Ej. jperez@cajadecredito.com" />
            </VBox>

            <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="2">
                <Label styleClass="field-label" text="Rol en el Sistema:" />
                <ComboBox fx:id="cmbRolSistema" maxWidth="Infinity" promptText="Seleccione un rol (Ej. Cajero / Asesor)" />
            </VBox>

            <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
                <Label styleClass="field-label" text="Contraseña Temporal:" />
                <PasswordField fx:id="txtClaveTemporal" promptText="••••••••" />
            </VBox>
        </GridPane>

        <HBox alignment="CENTER" style="-fx-padding: 10 0 0 0;">
            <Button onAction="#registrarNuevoUsuario" styleClass="primary-button" text="Registrar Usuario" />
        </HBox>
    </VBox>
</VBox>